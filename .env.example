# Copy to .env (gitignored) and set real values for any deployment holding data
# you care about. docker-compose reads .env automatically; nothing else does.
#
# Leaving this unset keeps the dev fallback (chuvar_dev_only), which is fine for
# a scratch database and not fine for anything else — the value is checked into
# docker-compose.yml, so every local process can read it.
CHUVAR_DB_PASSWORD=

# The services take their connection string from DATABASE_URL, or from a 0600
# file named by DATABASE_URL_FILE (preferred — an environment variable is
# readable via /proc by anything running as the same user, and is inherited by
# every child process).
#
#   DATABASE_URL_FILE=/home/you/.config/chuvar/apiserver.url
#
# One per service, each naming its own least-privilege role:
#   apiserver  -> chuvar_app
#   mcpserver  -> chuvar_agent
#   migrate    -> the owner
